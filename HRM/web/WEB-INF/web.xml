<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>homeController</servlet-name>
        <servlet-class>controller.homeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>homeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Chức năng 16: Active/Deactive Role -->
    <servlet>
        <servlet-name>ActiveDeactiveRoleController</servlet-name>
        <servlet-class>controller.ActiveDeactiveRoleController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ActiveDeactiveRoleController</servlet-name>
        <url-pattern>/activeDeactiveRole</url-pattern>
    </servlet-mapping>

    <!-- Chức năng 17: Edit Role Permission -->
    <servlet>
        <servlet-name>EditRolePermissionController</servlet-name>
        <servlet-class>controller.EditRolePermissionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditRolePermissionController</servlet-name>
        <url-pattern>/editRolePermission</url-pattern>
    </servlet-mapping>
</web-app>
