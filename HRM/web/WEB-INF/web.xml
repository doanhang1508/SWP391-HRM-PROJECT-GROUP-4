<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">

    <!-- ══════════════════════════════════════════════════════
         AUTH FILTER — Bảo vệ URL theo role
    ══════════════════════════════════════════════════════ -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/dashboard</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/hr/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/employee/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/manager/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/profile</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/settings</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/payroll</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/editRolePermission</url-pattern>
    </filter-mapping>
    <!-- FIX: đổi /role thành /role/* để bắt cả sub-path -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/role/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/terminate-employee</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/manual-reward-discipline</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/work-history</url-pattern>
    </filter-mapping>

    <!-- ══════════════════════════════════════════════════════
         SERVLET DECLARATIONS
         Chỉ khai báo các servlet KHÔNG dùng @WebServlet annotation
    ══════════════════════════════════════════════════════ -->

    <!-- Core (không có @WebServlet) -->
    <servlet>
        <servlet-name>homeController</servlet-name>
        <servlet-class>controller.homeController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>loginController</servlet-name>
        <servlet-class>controller.loginController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>logoutController</servlet-name>
        <servlet-class>controller.logoutController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>changePasswordController</servlet-name>
        <servlet-class>controller.changePasswordController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>notificationController</servlet-name>
        <servlet-class>controller.notificationController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ForgotPasswordController</servlet-name>
        <servlet-class>controller.ForgotPasswordController</servlet-class>
    </servlet>

    <!-- Admin (không có @WebServlet) -->
    <servlet>
        <servlet-name>ActiveDeactiveRoleController</servlet-name>
        <servlet-class>controller.admin.ActiveDeactiveRoleController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditRolePermissionController</servlet-name>
        <servlet-class>controller.admin.EditRolePermissionController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DepartmentsController</servlet-name>
        <servlet-class>controller.admin.DepartmentController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PendingRequestsController</servlet-name>
        <servlet-class>controller.admin.PendingRequestsController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PositionController</servlet-name>
        <servlet-class>controller.admin.PositionController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ContractTypeController</servlet-name>
        <servlet-class>controller.admin.ContractTypeController</servlet-class>
    </servlet>

    <!-- ══════════════════════════════════════════════════════
         URL MAPPINGS
         Chỉ map các servlet KHÔNG dùng @WebServlet annotation
    ══════════════════════════════════════════════════════ -->
    <servlet-mapping>
        <servlet-name>homeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>loginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>logoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>changePasswordController</servlet-name>
        <url-pattern>/changePassword</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>notificationController</servlet-name>
        <url-pattern>/notifications/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ForgotPasswordController</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ActiveDeactiveRoleController</servlet-name>
        <url-pattern>/activeDeactiveRole</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EditRolePermissionController</servlet-name>
        <url-pattern>/editRolePermission</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DepartmentsController</servlet-name>
        <url-pattern>/admin/department</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PendingRequestsController</servlet-name>
        <url-pattern>/admin/pending-requests</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PositionController</servlet-name>
        <url-pattern>/admin/position</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ContractTypeController</servlet-name>
        <url-pattern>/admin/contract-type</url-pattern>
    </servlet-mapping>

</web-app>
